            {
              "name": "POST - Crear tarea (Paso 13)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Pestaña Tests de POST /api/tasks (Paso 12 de la guía)",
                      "const responseBody = pm.response.json();",
                      "pm.collectionVariables.set('taskId', responseBody.data.id);",
                      "",
                      "pm.test('La tarea fue creada', () => {",
                      "    pm.response.to.have.status(201);",
                      "    pm.expect(responseBody.data.status).to.eql('pending');",
                      "});",
                      "",
                      "pm.test('El identificador tiene formato de 24 caracteres hex', () => {",
                      "    pm.expect(responseBody.data.id).to.match(/^[0-9a-fA-F]{24}$/);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"Preparar evidencia del CRUD\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/tasks",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "tasks"
                  ]
                }
              }
            },
            {
              "name": "GET - Listar tareas (Paso 14)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const responseBody = pm.response.json();",
                      "pm.test('Responde 200 y devuelve la lista de tareas', () => {",
                      "    pm.response.to.have.status(200);",
                      "    pm.expect(responseBody.data).to.be.an('array');",
                      "});",
                      "",
                      "pm.test('La lista incluye la tarea recién creada', () => {",
                      "    const taskId = pm.collectionVariables.get('taskId');",
                      "    const exists = responseBody.data.some(task => task.id === taskId);",
                      "    pm.expect(exists).to.be.true;",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/tasks",
                  "host": [
                    "{{baseUrl}}"
                  ],
