          "name": "1. Consultas y Paginación",
          "item": [
            {
              "name": "GET - Listado predeterminado sin parámetros (Paso 15)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const body = pm.response.json();",
                      "pm.test('Responde 200 con data y meta', () => {",
                      "    pm.response.to.have.status(200);",
                      "    pm.expect(body.data).to.be.an('array');",
                      "    pm.expect(body.meta).to.be.an('object');",
                      "});",
                      "",
                      "pm.test('Metadatos por defecto: page=1 y limit=10', () => {",
                      "    pm.expect(body.meta.page).to.eql(1);",
                      "    pm.expect(body.meta.limit).to.eql(10);",
                      "    pm.expect(body.meta.total).to.be.a('number');",
                      "    pm.expect(body.meta.totalPages).to.be.a('number');",
                      "});",
                      "",
                      "pm.test('Documentos no exponen _id ni __v', () => {",
                      "    body.data.forEach(task => {",
                      "        pm.expect(task.id).to.be.a('string');",
                      "        pm.expect(task._id).to.be.undefined;",
                      "        pm.expect(task.__v).to.be.undefined;",
                      "    });",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/tasks",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "tasks"]
                }
              }
            },
