            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=completed&search=A9&sortBy=title&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "status", "value": "completed" },
                { "key": "search", "value": "A9" },
                { "key": "sortBy", "value": "title" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
