{
  "info": {
    "_postman_id": "b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d5e",
    "name": "EC3 F1 A9 Auth - Task API Express",
    "description": "Colección completa de pruebas para EC3 F1 A9: Registro, Login con JWT, Casos Negativos y Regresión del CRUD de Tareas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Pruebas Positivas",
      "item": [
        {
          "name": "P1 - Registrar usuario (Paso 20)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Responde 201 Created', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(body.data.user).to.be.an('object');",
                  "    pm.expect(body.data.user.role).to.eql('user');",
                  "});",
                  "",
                  "pm.test('No expone password ni passwordHash', () => {",
                  "    pm.expect(body.data.user.password).to.be.undefined;",
                  "    pm.expect(body.data.user.passwordHash).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Torres\",\n  \"email\": \"ana.torres@example.com\",\n  \"password\": \"Frase segura para clase 2026\",\n  \"confirmPassword\": \"Frase segura para clase 2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "P2 - Iniciar sesión (Paso 21)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Responde 200 con accessToken Bearer', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.data.accessToken).to.be.a('string');",
                  "    pm.expect(body.data.tokenType).to.eql('Bearer');",
                  "    pm.expect(body.data.expiresIn).to.eql('1h');",
                  "    pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "});",
                  "",
                  "pm.test('No expone passwordHash en el usuario', () => {",
                  "    pm.expect(body.data.user.passwordHash).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.torres@example.com\",\n  \"password\": \"Frase segura para clase 2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
