{
  "info": {
    "_postman_id": "c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e5f",
    "name": "EC3 F2 A10 Protección - Task API Express",
    "description": "Colección completa de pruebas para EC3 F2 A10: Autenticación Bearer JWT, Autorización por Roles (Admin DELETE), Helmet, CORS, Rate Limit y Desafío /api/auth/me.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Rutas Públicas y Login",
      "item": [
        {
          "name": "GET - Salud pública y cabeceras Helmet (Paso 17)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GET /health responde 200 sin token', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Helmet incluye X-Content-Type-Options: nosniff', () => {",
                  "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "POST - Registro usuario normal (Paso 17)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "pm.test('Registro responde 201 o 409 si ya existe', () => {",
                  "    pm.expect([201, 409]).to.include(status);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Torres\",\n  \"email\": \"ana.torres@example.com\",\n  \"password\": \"Frase segura para clase 2026\",\n  \"confirmPassword\": \"Frase segura para clase 2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "POST - Login y guardar userToken (Paso 17)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Login responde 200 con accessToken', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.data.accessToken).to.be.a('string');",
                  "    pm.expect(body.data.user.role).to.eql('user');",
                  "    pm.collectionVariables.set('userToken', body.data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.torres@example.com\",\n  \"password\": \"Frase segura para clase 2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Errores de Autenticación (401)",
      "item": [
        {
          "name": "GET - Tareas sin encabezado Authorization (Paso 18)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Responde 401 AUTHENTICATION_REQUIRED', () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(body.error.code).to.eql('AUTHENTICATION_REQUIRED');",
                  "    pm.expect(body.error.requestId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "GET - Tareas con token sin esquema Bearer (Paso 18)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Responde 401 INVALID_AUTHORIZATION_HEADER', () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(body.error.code).to.eql('INVALID_AUTHORIZATION_HEADER');",
                  "    pm.expect(body.error.requestId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{userToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "GET - Tareas con Bearer inválido (Paso 18)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Responde 401 INVALID_TOKEN', () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(body.error.code).to.eql('INVALID_TOKEN');",
                  "    pm.expect(body.error.requestId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer token.invalido.firmado" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        }
      ]
    },
    {
      "name": "3. CRUD Autenticado y Permisos (200 / 403 / 204)",
      "item": [
        {
          "name": "POST - Crear tarea con userToken (Paso 19)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('POST /api/tasks con userToken responde 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.collectionVariables.set('taskId', body.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Probar middleware de autenticacion\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "GET - Listar tareas con userToken (Paso 19)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('GET /api/tasks responde 200 con data y meta', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.data).to.be.an('array');",
                  "    pm.expect(body.meta).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks?page=1&limit=5&status=pending&search=middleware&sortBy=title&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "5" },
                { "key": "status", "value": "pending" },
                { "key": "search", "value": "middleware" },
                { "key": "sortBy", "value": "title" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "PATCH - Completar tarea con userToken (Paso 19)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('PATCH /complete con userToken responde 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.data.status).to.eql('completed');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "complete"]
            }
          }
        },
        {
          "name": "DELETE - Usuario normal falla (403 FORBIDDEN) (Paso 20)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('DELETE con userToken responde 403 FORBIDDEN', () => {",
                  "    pm.response.to.have.status(403);",
                  "    pm.expect(body.error.code).to.eql('FORBIDDEN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "POST - Login como admin (Paso 20)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('adminToken', body.data.accessToken);",
                  "    pm.test('Login admin exitoso', () => {",
                  "        pm.expect(body.data.accessToken).to.be.a('string');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.torres@example.com\",\n  \"password\": \"Frase segura para clase 2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "DELETE - Admin elimina con éxito (204) (Paso 20)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('DELETE con adminToken responde 204 sin cuerpo', () => {",
                  "    pm.response.to.have.status(204);",
                  "    pm.expect(pm.response.text()).to.eql('');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. CORS, Helmet y Rate Limiting",
      "item": [
        {
          "name": "CORS - Origen permitido recibe encabezado (Paso 21)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Origen permitido recibe Access-Control-Allow-Origin', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://localhost:5173');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Origin", "value": "http://localhost:5173" }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "CORS - Origen no permitido NO recibe encabezado (Paso 21)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Origen no permitido no recibe Access-Control-Allow-Origin', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.be.null;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Origin", "value": "https://sitio-no-autorizado.example" }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Desafío Individual /api/auth/me",
      "item": [
        {
          "name": "GET - /api/auth/me con Token válido (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Responde 200 con data.identity', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.data.identity.userId).to.be.a('string');",
                  "    pm.expect(body.data.identity.role).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('No expone token, email ni passwordHash', () => {",
                  "    pm.expect(body.data.identity.accessToken).to.be.undefined;",
                  "    pm.expect(body.data.identity.email).to.be.undefined;",
                  "    pm.expect(body.data.identity.passwordHash).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "GET - /api/auth/me sin Token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Sin token responde 401 AUTHENTICATION_REQUIRED', () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(body.error.code).to.eql('AUTHENTICATION_REQUIRED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    }
  ]
}
